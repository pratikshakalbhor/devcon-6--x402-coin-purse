# ---------------------------------------------------------------------------
# coin-purse environment
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit a private key.
#
# Every variable in the SPEND POLICY block is read by purse/config.ts and by
# nothing else. There is no code path that overrides them.
# ---------------------------------------------------------------------------

# --- SPEND POLICY (purse/config.ts) ----------------------------------------

# Largest single payment, in USDC base units (6 decimals).
#   50_000   = 0.05 USDC
#   500_000  = 0.50 USDC
# Must be a plain integer string. "0.05" is rejected at boot: floats are not
# accepted anywhere in this codebase.
PER_CALL_MAX_BASE_UNITS=50000

# Cumulative ceiling for the whole run, in USDC base units.
#   5_000_000 = 5.00 USDC
# Enforced against the ledger on disk, so it survives a restart.
TOTAL_BUDGET_BASE_UNITS=5000000

# Comma-separated CAIP-2 network ids. Mainnet ids are rejected at boot.
#   eip155:84532 = Base Sepolia
ALLOWED_NETWORKS=eip155:84532

# Comma-separated token contract addresses. Normalized to lowercase.
# Base Sepolia USDC (Circle testnet token, 6 decimals):
ALLOWED_ASSETS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# --- WALLET (purse/guardedFetch.ts) ----------------------------------------
# The key the purse signs EIP-3009 transfer authorizations with.
# MUST be funded with testnet USDC on Base Sepolia.
# Format: 0x + 64 hex chars. Generate a throwaway one with:
#   cast wallet private-key --account 0            # foundry
#   node -e "console.log(require('viem/accounts').privateKeyToAccount(viem.generatePrivateKey()).privateKey)"
WALLET_PRIVATE_KEY=

# --- LEDGER (purse/ledger.ts) ----------------------------------------------
# SQLite file holding every decision. Relative paths resolve from repo root.
LEDGER_DB_PATH=ledger/spend.db

# --- LLM (agent/agent.ts) --------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- SELLERS (sellers/*.ts) ------------------------------------------------
# Where the sellers listen.
HONEST_PORT=4021
ROGUE_PORT=4022

# The x402 facilitator the sellers use to verify and settle payments.
# Defaults to a local facilitator on :4023, which needs no credentials.
FACILITATOR_URL=http://127.0.0.1:4023

# Bearer token, sent on every facilitator call. Leave empty for a facilitator
# that needs no auth (e.g. a local one).
FACILITATOR_AUTH_TOKEN=
#
# NOT WIRED UP: the public Coinbase facilitator above does NOT accept a bare
# bearer token, it wants a CDP API key presented as an ES256 JWT, and no code in
# this repo builds that JWT. CDP_API_KEY_ID / CDP_API_KEY_SECRET are therefore
# deliberately absent. To use the public facilitator you need either a proxy
# that mints the JWT, or a facilitator that accepts FACILITATOR_AUTH_TOKEN.
# See "Limitations" in README.md.

# The facilitator settles on-chain, so it needs a funded testnet key to pay gas.
FACILITATOR_PRIVATE_KEY=

# Base Sepolia JSON-RPC. Public default is fine for a demo.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Where the seller collects payments. Defaults to the facilitator wallet.
SELLER_PAY_TO_ADDRESS=
