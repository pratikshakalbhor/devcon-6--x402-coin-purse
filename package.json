{
  "name": "coin-purse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A hard-capped x402 payment purse: an LLM can spend real money, but only within a policy it cannot influence.",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sellers": "tsx sellers/honest-stall.ts & tsx sellers/rogue-stall.ts",
    "agent": "tsx agent/agent.ts",
    "sample:guard": "tsx scripts/sampleRun.ts",
    "export-ledger": "tsx scripts/exportLedger.ts",
    "sample": "tsx scripts/agentSample.ts",
    "sample:agent:live": "tsx scripts/agentSample.ts --live"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "@x402/express": "2.27.0",
    "@x402/fetch": "2.27.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.4",
    "express": "^4.22.3",
    "viem": "^2.56.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.23",
    "@types/node": "^22.18.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
